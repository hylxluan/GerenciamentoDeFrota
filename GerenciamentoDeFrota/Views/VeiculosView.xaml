<UserControl x:Class="GerenciamentoDeFrota.Views.VeiculosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:GerenciamentoDeFrota.Helpers">

    <UserControl.Resources>
        <helpers:BoolToSimNaoConverter x:Key="BoolToSimNao"/>
        <BooleanToVisibilityConverter  x:Key="BoolToVis"/>

        <SolidColorBrush x:Key="CardBrush"  Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextStrong" Color="#1F2A37"/>
        <SolidColorBrush x:Key="TextSoft"   Color="#6B7280"/>
        <SolidColorBrush x:Key="LineBrush"  Color="#E5E7EB"/>
        <SolidColorBrush x:Key="BgPage"     Color="#F9FAFB"/>

        <!-- Cabeçalho do DataGrid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="#F3F4F6"/>
            <Setter Property="Foreground"   Value="{StaticResource TextSoft}"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Padding"      Value="8,0"/>
            <Setter Property="BorderBrush"  Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Célula do DataGrid -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding"       Value="8,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="Foreground"    Value="{StaticResource TextStrong}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Linha do DataGrid -->
        <Style TargetType="DataGridRow">
            <Setter Property="Height" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0FDF4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BgPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
            <RowDefinition Height="Auto"/>
            <!-- Mensagens -->
        </Grid.RowDefinitions>

        <!-- ── Toolbar ──────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="TruckOutline" Width="22" Height="22"
                                             Foreground="#16A34A" VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>
                    <TextBlock Text="Veículos"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextStrong}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Busca -->
                <Border Grid.Column="1"
                        Margin="24,0"
                        Height="36"
                        Background="#F9FAFB"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Grid.Column="0"
                                                 Kind="Magnify"
                                                 Width="16" Height="16"
                                                 Foreground="{StaticResource TextSoft}"
                                                 VerticalAlignment="Center"
                                                 Margin="10,0,6,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Foreground="{StaticResource TextStrong}"
                                 VerticalContentAlignment="Center"
                                 Padding="0,0,10,0">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid>
                                                    <TextBlock Text="Buscar por placa, modelo, fabricante ou frota..."
                                                               Foreground="{StaticResource TextSoft}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Margin="2,0,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <!-- Botão Novo -->
                <Button Grid.Column="2"
                        Command="{Binding NovoVeiculoCommand}"
                        Height="36" Cursor="Hand" Background="#16A34A"
                        BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                <StackPanel Orientation="Horizontal" Margin="14,0">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"
                                                             Foreground="White" VerticalAlignment="Center"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Text="Novo Veículo" Foreground="White"
                                               FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#15803D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── DataGrid ─────────────────────────────────────────────────── -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Veiculos}"
                  SelectedItem="{Binding Selecionado}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  ColumnHeaderHeight="36"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource LineBrush}"
                  RowBackground="#FFFFFF"
                  AlternatingRowBackground="#FAFAFA"
                  BorderThickness="0"
                  CanUserAddRows="False"
                  CanUserResizeRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  IsReadOnly="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="0">

            <DataGrid.Columns>

                <!-- ── Ações ─────────────────────────────────────────────── -->
                <DataGridTemplateColumn Header="" Width="76" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <!-- Editar -->
                                <Button Command="{Binding DataContext.EditarItemCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Width="28" Height="28" Cursor="Hand"
                                        Background="#EFF6FF" BorderThickness="0"
                                        Margin="0,0,4,0" ToolTip="Editar">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                                <materialDesign:PackIcon Kind="PencilOutline"
                                                                         Width="13" Height="13"
                                                                         Foreground="#2563EB"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#DBEAFE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- Deletar -->
                                <Button Command="{Binding DataContext.DeletarItemCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Width="28" Height="28" Cursor="Hand"
                                        Background="#FFEBEB" BorderThickness="0"
                                        ToolTip="Excluir">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="6" Background="{TemplateBinding Background}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline"
                                                                         Width="13" Height="13"
                                                                         Foreground="#DC2626"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FCA5A5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- ── Identificação ─────────────────────────────────────── -->
                <DataGridTextColumn Header="Cód."
                                    Binding="{Binding Id, StringFormat={}{0:D6}}"
                                    Width="68" CanUserSort="True"/>

                <DataGridTextColumn Header="Nr. Frota"
                                    Binding="{Binding NumeroFrota}"
                                    Width="80"/>

                <DataGridTextColumn Header="Placa"
                                    Binding="{Binding Placa}"
                                    Width="90"/>

                <DataGridTextColumn Header="Renavam"
                                    Binding="{Binding Renavam}"
                                    Width="110"/>

                <DataGridTextColumn Header="Fabricante"
                                    Binding="{Binding Fabricante}"
                                    Width="160"/>

                <DataGridTextColumn Header="Modelo"
                                    Binding="{Binding Modelo}"
                                    Width="180"/>

                <DataGridTextColumn Header="Tipo de Veículo"
                                    Binding="{Binding Tipo}"
                                    Width="220"/>

                <DataGridTextColumn Header="Cor"
                                    Binding="{Binding Cor}"
                                    Width="80"/>

                <DataGridTextColumn Header="UF"
                                    Binding="{Binding UF}"
                                    Width="50"/>

                <DataGridTextColumn Header="Ano Fab."
                                    Binding="{Binding AnoFabricacao}"
                                    Width="80"/>

                <DataGridTextColumn Header="Ano Mod."
                                    Binding="{Binding AnoModelo}"
                                    Width="80"/>

                <DataGridTextColumn Header="KM / Horímetro"
                                    Binding="{Binding KmAtual, StringFormat={}{0:N0}}"
                                    Width="110"/>

                <!-- ── Proprietário ──────────────────────────────────────── -->
                <DataGridTextColumn Header="Proprietário"
                                    Binding="{Binding Proprietario}"
                                    Width="200"/>

                <DataGridTextColumn Header="CNPJ"
                                    Binding="{Binding CNPJ}"
                                    Width="160"/>

                <!-- ── Dados Técnicos ────────────────────────────────────── -->
                <DataGridTextColumn Header="Tara (Kg)"
                                    Binding="{Binding TaraKg, StringFormat={}{0:N2}}"
                                    Width="90"/>

                <DataGridTextColumn Header="Lotação (Kg)"
                                    Binding="{Binding LotacaoKg, StringFormat={}{0:N2}}"
                                    Width="100"/>

                <!-- ── Documentos e Vencimentos ──────────────────────────── -->
                <DataGridTextColumn Header="Licenciamento"
                                    Binding="{Binding Licenciamento}"
                                    Width="105"/>

                <DataGridTextColumn Header="Dt. Venc. Lic."
                                    Binding="{Binding LicenciamentoDtVencimento, StringFormat=dd/MM/yyyy}"
                                    Width="110"/>

                <DataGridTextColumn Header="IPVA"
                                    Binding="{Binding Ipva}"
                                    Width="60"/>

                <DataGridTextColumn Header="Dt. Venc. IPVA"
                                    Binding="{Binding IpvaDtVencimento, StringFormat=dd/MM/yyyy}"
                                    Width="110"/>

                <DataGridTextColumn Header="ANTT"
                                    Binding="{Binding Antt}"
                                    Width="120"/>

                <DataGridTextColumn Header="Dt. Venc. ANTT"
                                    Binding="{Binding AnttDtVencimento, StringFormat=dd/MM/yyyy}"
                                    Width="110"/>

                <DataGridTextColumn Header="Dt. Venc. Tacógrafo"
                                    Binding="{Binding DataTacografo, StringFormat=dd/MM/yyyy}"
                                    Width="130"/>

                <DataGridTextColumn Header="Dt. Venc. Cronoacógrafo"
                                    Binding="{Binding CronoacografoDtVencimento, StringFormat=dd/MM/yyyy}"
                                    Width="160"/>

                <DataGridTextColumn Header="Dt. Venc. Extintor"
                                    Binding="{Binding ExtintorDtVencimento, StringFormat=dd/MM/yyyy}"
                                    Width="120"/>

                <!-- ── Centro de Custo ───────────────────────────────────── -->
                <DataGridTextColumn Header="Centro de Custo"
                                    Binding="{Binding CentrosCusto.Nome}"
                                    Width="230"/>

                <!-- ── Status ────────────────────────────────────────────── -->
                <DataGridTextColumn Header="Ativo"
                                    Binding="{Binding Ativo, Converter={StaticResource BoolToSimNao}}"
                                    Width="60"/>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Mensagens ─────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <Grid>
                <!-- Erro -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding MensagemErro,
                                Converter={StaticResource BoolToVis},
                                ConverterParameter=inverse}">
                    <TextBlock Text="{Binding MensagemErro}"
                               Foreground="#DC2626" FontSize="12"
                               Visibility="{Binding MensagemErro,
                                   Converter={StaticResource BoolToVis}}"/>
                </StackPanel>

                <!-- Sucesso -->
                <TextBlock Text="{Binding MensagemSucesso}"
                           Foreground="#16A34A" FontSize="12"
                           HorizontalAlignment="Left"/>

                <!-- Contagem -->
                <TextBlock HorizontalAlignment="Right"
                           FontSize="11" Foreground="{StaticResource TextSoft}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} veículo(s)">
                            <Binding Path="Veiculos.Count"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
        </Border>

    </Grid>
</UserControl>
